NODE_ENV=development
PORT=3000
API_PORT=3000

DB_HOST=localhost
DB_HOST_DOCKER=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=amanpay_back_db
DB_EXPOSE_PORT=5432

# Optional compose overrides
API_CONTAINER_NAME=amanpay-back-api
DB_CONTAINER_NAME=amanpay-back-postgres
POSTGRES_IMAGE=postgres:16-alpine

# Local only: auto-sync schema from entities (never use in production)
DB_SYNC=false

# Run TypeORM migrations on startup (set false to run migrations manually)
RUN_MIGRATIONS_ON_START=true
# Run seed on startup (dev-only)
RUN_SEED_ON_START=true

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
PASSWORD_RESET_TOKEN_EXPIRES=30m

# Optional: create first admin if missing (requires email + password)
SEED_DEFAULT_ADMIN=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-8-chars-min
